# The ps2build SDK CI builds with, pinned to exact releases.
# Every version below is pinned, so tools/ps2build_sdk.sh --resolve makes no network call: the SDK cached under
# these versions is restored, and only on a cache miss is anything installed: from the official GitHub releases
# (github.com/ps2build) first, then, when they fail, from the private NathanNeurotic/old-ps2build-mirror release
# named by PS2BUILD_SDK_TAG (its SHA256SUMS must hash to PS2BUILD_SDK_SUMS_SHA256).
#
# These are the versions RiptOPL and Launchstation pin (their weekly watch proposes new ones). To move on, copy
# their four lines below. Editing a version by hand? Then also clear PS2BUILD_SDK_TAG and
# PS2BUILD_SDK_SUMS_SHA256 (the mirror fallback then takes the newest mirror release), unless that mirror release
# holds exactly the new versions. A bare name (no =version) follows the newest release, at one manifest request
# per run.
PS2BUILD_SDK_MIRROR=NathanNeurotic/old-ps2build-mirror
PS2BUILD_SDK_TAG=sdk-v2026.11.07-cd4281a8
PS2BUILD_SDK_SUMS_SHA256=56f40717d2785c727ebef6e21afb7fc71e914ee3f468f6e45a30e551ffeedd4f
PS2BUILD_COMPONENTS="cmake=v2026.11.04 ninja=v1.13.2 ps2build=v2026.11.07 sdk-core=v2026.11.05 sdk-world=v2026.11.05 toolchain=v2026.11.04 tools=v2026.11.04 vcl=v2026.11.04"
PS2BUILD_LLVM_TOOLCHAIN=v2026.11.05
